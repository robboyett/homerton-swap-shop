# Copy to .env for local dev. Never commit .env.

# Phase 2. 32+ random characters; seals the session cookie.
# Generate one with: node -e "console.log(crypto.randomUUID().replace(/-/g,'')+crypto.randomUUID().replace(/-/g,''))"
NUXT_SESSION_SECRET=

# Phase 2. Neon connection string, from Vercel Storage:
# vercel env pull .env.local, then copy it here.
DATABASE_URL=

# Phase 3. Vercel Blob, for cover photos and collection photos. Same place.
BLOB_READ_WRITE_TOKEN=

# Phase 4. Reading title and author off a photographed cover when there is no barcode.
# Model ids are Vercel AI Gateway strings. Leave COVER_MODEL empty and the fallback is off.
COVER_MODEL=
AI_GATEWAY_API_KEY=
